---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { getHomeGalleryImages } from '../utils/data';
import ProjectIndex from '../components/project.astro';

const galleryImages = await getHomeGalleryImages();

const images = galleryImages.length > 0
  ? galleryImages.map(img => ({ url: img.image_url, isDark: img.is_dark }))
  : [
    { url: '/assets/home/image1.png', isDark: false },
    { url: '/assets/home/image2.png', isDark: false },
    { url: '/assets/home/image3.png', isDark: false },
    { url: '/assets/home/image4.png', isDark: false },
    { url: '/assets/home/image5.png', isDark: true },
    { url: '/assets/home/image6.png', isDark: false },
    { url: '/assets/home/image7.png', isDark: false },
    { url: '/assets/home/image8.png', isDark: false },
  ];

const totalImages = images.length;
---

<Layout title="Salty Architects" isHomePage={true}>
	<div class="relative h-screen w-full overflow-hidden">
		<div id="carousel" class="relative h-full w-full">

			<div class="absolute inset-0">
				<img
					id="carousel-image-1"
					src={images[0]?.url || ''}
					class="absolute inset-0 w-full h-full object-cover object-top transition-opacity duration-300"
				/>
				<img
					id="carousel-image-2"
					src=""
					class="absolute inset-0 w-full h-full object-cover object-top opacity-0 transition-opacity duration-300"
				/>
			</div>

			<div class="absolute inset-0 flex items-center justify-center text-center">
				<h1 id="main-title" class="text-black font-brown transition-colors duration-700">
					Salty Architects
				</h1>
			</div>

			<div id="prev-zone" class="absolute top-0 left-0 w-1/5 h-full cursor-left z-10"></div>
			<div id="next-zone" class="absolute top-0 right-0 w-1/5 h-full cursor-right z-10"></div>

			<div id="image-counter" class="slider-counter text-black">
				<span id="current-image">1</span> /
				<span id="total-images">{String(totalImages).padStart(2)}</span>
			</div>

			<div id="dots" class="dots-container"></div>

		</div>
	</div>

	<ProjectIndex />

	<style>
		#main-title {
			font-size: 100px;
			line-height: 122px;
			transition: opacity 0.5s ease;
		}
		.slider-counter {
			left: 20px;
			bottom: 11px;
			display: flex;
			font-size: 18px;
			font-weight: 400;
			line-height: 22px;
			position: absolute;
			align-items: center;
		}
		.cursor-left {
			cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>') 12 12, auto;
		}
		.cursor-right {
			cursor: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>') 12 12, auto;
		}
		@media (min-width: 768px) {
			.dots-container {
				display: none;
			}
		}
		@media (max-width: 768px) {
			.slider-counter, .cursor-left, .cursor-right {
				display: none;
			}
			#main-title {
				font-size: 70px;
				line-height: 100px;
			}
		}
		@media (max-width: 575.98px) {
			#main-title {
				font-size: 30px;
				line-height: 50px;
			}
		}
	</style>
	<style is:global>
		@media (min-width: 768px) {
			#projects-container {
				display: none;
			}
		}
		@media (max-width: 768px) {
			.project-wrapper {
				height: auto !important;
			}
		}
		.dots-container {
			gap: 5px;
			left: 50%;
			width: 100%;
			z-index: 20;
			bottom: 13%;
			display: flex;
			position: absolute;
			transform: translateX(-50%);
		}
		.dot {
			flex: 1;
			height: 2px;
			cursor: pointer;
			transition: all 0.3s ease;
			background: rgba(0, 0, 0, 0.2);
		}
		.dot.active {
			background: #000;
		}
		.is-home .mobile-sidebar {
			background: transparent;
		}
		.is-home .mobile-sidebar.open {
			border-style: solid;
			border-color: #3D3D3D;
			border-width: 1px 0px 1px 0px;
		}
		.is-home #main-title {
			opacity: 1;
		}
		.is-home:has(.mobile-sidebar.open) #main-title {
			opacity: 0;
		}
		.is-home .project-body {
			height: auto;
		}
	</style>

	<script define:vars={{ images }}>
		let currentIndex = 0;
		let activeImage = 1;
		let autoPlayInterval;

		const image1 = document.getElementById('carousel-image-1');
		const image2 = document.getElementById('carousel-image-2');
		const currentImageSpan = document.getElementById('current-image');
		const prevZone = document.getElementById('prev-zone');
		const nextZone = document.getElementById('next-zone');
		const mainTitle = document.getElementById('main-title');
		const imageCounter = document.getElementById('image-counter');
		const dotsContainer = document.getElementById('dots');

		function updateTextColor(isDark) {
			if (isDark) {
				mainTitle.classList.replace('text-black', 'text-white');
				imageCounter.classList.add('text-white');
			} else {
				mainTitle.classList.replace('text-white', 'text-black');
				imageCounter.classList.remove('text-white');
			}
		}

		function updateDots() {
			const dots = document.querySelectorAll('.dot');
			dots.forEach((dot, i) => {
				dot.classList.toggle('active', i === currentIndex);
			});
		}

		function renderDots() {
			dotsContainer.innerHTML = '';

			images.forEach((_, i) => {
				const dot = document.createElement('div');
				dot.classList.add('dot');

				if (i === currentIndex) dot.classList.add('active');

				dot.addEventListener('click', () => {
				currentIndex = i;
				updateImage();
				resetAutoPlay();
				});

				dotsContainer.appendChild(dot);
			});
		}

		function updateImage() {
			const nextImg = activeImage === 1 ? image2 : image1;
			const currentImg = activeImage === 1 ? image1 : image2;

			nextImg.src = images[currentIndex].url;
			currentImageSpan.textContent = String(currentIndex + 1).padStart(2);
			updateTextColor(images[currentIndex].isDark);

			nextImg.classList.remove('opacity-0');
			currentImg.classList.add('opacity-0');

			activeImage = activeImage === 1 ? 2 : 1;

			updateDots();
		}

		function nextImage() {
			currentIndex = (currentIndex + 1) % images.length;
			updateImage();
			resetAutoPlay();
		}

		function prevImage() {
			currentIndex = (currentIndex - 1 + images.length) % images.length;
			updateImage();
			resetAutoPlay();
		}

		function startAutoPlay() {
			stopAutoPlay();

			autoPlayInterval = setInterval(() => {
				nextImage(false);
			}, 3000);
		}

		function stopAutoPlay() {
			if (autoPlayInterval) {
				clearInterval(autoPlayInterval);
			}
		}

		function resetAutoPlay() {
			startAutoPlay();
		}

		updateTextColor(images[0]?.isDark || false);
		renderDots();

		images.forEach(img => {
			const preload = new Image();
			preload.src = img.url;
		});

		startAutoPlay();

		prevZone.addEventListener('click', prevImage);
		nextZone.addEventListener('click', nextImage);

		document.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') prevImage();
			if (e.key === 'ArrowRight') nextImage();
		});

		const carousel = document.getElementById('carousel');
		carousel.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
		carousel.addEventListener('mouseleave', startAutoPlay);
	</script>
</Layout>